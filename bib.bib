@book{mobileAppEngineering,
author = {Vollmer, Guy},
address = {Heidelberg},
booktitle = {Mobile App Engineering :  eine systematische Einführung - von den Requirements zum Go Live /},
edition = {1. Auflage},
isbn = {3864904218},
keywords = {Softwareentwicklung ; Requirements engineering ; Implementierung ; Softwaretest ; Mobiles Endgerät ; App ; Software Engineering},
language = {ger},
publisher = {: dpunkt.verlag},
title = {Mobile App Engineering :  eine systematische Einführung - von den Requirements zum Go Live / },
url = {http://vub.de/cover/data/isbn:9783864904219/medium/true/de/vub/cover.jpg},
year = {2017},
abstract = {Das vorliegende Buch beschäftigt sich mit der Erstellung von Anwendungssoftware für Smartphones und Tablets von den Anforderungen (Lastenheft) bis zur Programmierung hin. Mit den Aspekten Design und Vermarktung hat sich bereits M. Albrecht beschäftigt. D. Knott legt den Schwerpunkt auf das Testen und die Sicherheit und Zuverlässigkeit dieser Apps. Das Buch hier behandelt die spezifischen Herausforderungen und die signifikanten Unterschiede zur Softwareentwicklung für Desktop- und Notebook-Computer. Betrachtet wird der gesamte Lebenszyklus einer mobilen App. Der Autor stützt sich auf ein Praxisbeispiel, die Entwicklung der nativen mobilen Stromversorgungs-App ENPURE für das Unternehmen Vattenfall. Schwerpunkte liegen bei der Konzeptions- und Designphase des Beispielprojekts, den Implementierungsaktivitäten und den verschiedenen Testphasen. Gut berücksichtigt werden auch Veröffentlichungsmöglichkeiten in App-Stores. Viele Abbildungen, Zusammenfassungen zu den einzelnen Kapiteln sowie ein umfangreiches Literatur- und Quellenverzeichnis im Anhang},
}

