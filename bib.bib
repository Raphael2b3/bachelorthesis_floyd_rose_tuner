@misc{kroon2022comparingconventionalpitchdetection,
      title={Comparing Conventional Pitch Detection Algorithms with a Neural Network Approach}, 
      author={Anja Kroon},
      year={2022},
      eprint={2206.14357},
      archivePrefix={arXiv},
      primaryClass={eess.AS},
      url={https://arxiv.org/abs/2206.14357}, 
}@article{SUKHOSTAT2015410,
title = {A Comparative Analysis of Pitch Detection Methods Under the Influence of Different Noise Conditions},
journal = {Journal of Voice},
volume = {29},
number = {4},
pages = {410-417},
year = {2015},
issn = {0892-1997},
doi = {https://doi.org/10.1016/j.jvoice.2014.09.016},
url = {https://www.sciencedirect.com/science/article/pii/S0892199714002021},
author = {Lyudmila Sukhostat and Yadigar Imamverdiyev},
keywords = {Pitch detection, Time-domain methods, Frequency, Domain methods, Hybrid methods},
abstract = {Summary
Objectives/Hypothesis
Pitch is one of the most important components in various speech processing systems. The aim of this study was to evaluate different pitch detection methods in terms of various noise conditions.
Study Design
Prospective study.
Methods
For evaluation of pitch detection algorithms, time-domain, frequency-domain, and hybrid methods were considered by using Keele and CSTR speech databases. Each of them has its own advantages and disadvantages.
Results
Experiments have shown that BaNa method achieves the highest pitch detection accuracy.
Conclusions
The development of methods for pitch detection, which are robust to additive noise at different signal-to-noise ratio, is an important field of research with many opportunities for enhancement the modern methods.}
}